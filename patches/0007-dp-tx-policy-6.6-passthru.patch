+/* The original 6.6 completion path must use the Wonder-specific descriptor
+ * handler when firmware returns a passthru-mode vdev. Never replace the
+ * default fast path for normal station/AP vdevs.
+ */
+static inline void dp_tx_comp_process_tx_status_n_desc_wrapper(
+                struct dp_soc *soc, struct dp_vdev *vdev,
+                struct dp_tx_desc_s *tx_desc,
+                struct hal_tx_completion_status *ts,
+                struct dp_txrx_peer *txrx_peer, uint8_t ring_id)
+{
+#ifdef DRIVER_PASSTHRU_MODE
+        if (qdf_unlikely(vdev && vdev->opmode == wlan_op_mode_passthru)) {
+                dp_tx_comp_process_tx_status_passthru(soc, tx_desc, ts,
+                                                      txrx_peer, ring_id);
+                dp_tx_comp_process_desc_passthru(soc, tx_desc, ts,
+                                                 txrx_peer);
+                return;
+        }
+#endif
+        dp_tx_comp_process_tx_status(soc, tx_desc, ts, txrx_peer, ring_id);
+        dp_tx_comp_process_desc(soc, tx_desc, ts, txrx_peer);
+}
