@@ -777,6 +778,7 @@
 	QDF_AHDEMO_MODE,
 	QDF_TDLS_MODE,
 	QDF_NAN_DISC_MODE,
+	QDF_PASSTHRU_MODE,
 
 	/* Add new OP Modes to qdf_opmode_str as well */
 
diff --git a/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/qdf/src/qdf_types.c b/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/qdf/src/qdf_types.c
