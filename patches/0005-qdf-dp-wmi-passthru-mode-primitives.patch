diff --git a/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/qdf/inc/qdf_types.h b/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/qdf/inc/qdf_types.h
--- a/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/qdf/inc/qdf_types.h
+++ b/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/qdf/inc/qdf_types.h
