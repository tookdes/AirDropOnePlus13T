+++ b/vendor/qcom/opensource/wlan/qca-wifi-host-cmn/umac/mlme/vdev_mgr/dispatcher/src/wlan_vdev_mgr_utils_api.c
@@ -112,6 +112,9 @@
 		break;
 	case QDF_NDI_MODE:
 		cdp_txrx_opmode = wlan_op_mode_ndi;
